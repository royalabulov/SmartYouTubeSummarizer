<Window x:Class="SmartYouTubeSummarizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Smart YouTube Summarizer" Height="650" Width="950"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:SmartYouTubeSummarizer">
        
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#11111B" BorderBrush="#313244" BorderThickness="0,0,1,0">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Name="btnNewChat" Grid.Row="0" Content="+ Yeni Konspekt" 
                        Padding="10" FontSize="14" FontWeight="SemiBold"
                        Background="#313244" Foreground="#C6A0F6" BorderThickness="0" Cursor="Hand" Margin="0,0,0,15">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ListBox Name="lstHistory" Grid.Row="1" Background="Transparent" BorderThickness="0"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
         d:ItemsSource="{d:SampleData ItemCount=5}">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Name="itemBorder"
                    Background="#1E1E2E" CornerRadius="6" Padding="10" 
                    Margin="0,4" BorderBrush="#313244" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Sol accent xətti -->
                                    <Border Name="accentLine"
                            Grid.Column="0" Width="3" CornerRadius="2"
                            Background="#89B4FA" Margin="0,0,8,0"
                            Opacity="0"/>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title, FallbackValue='YouTube Video Başlığı'}" 
                                   Foreground="#CDD6F4" FontSize="13" FontWeight="Medium" 
                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding VideoUrl, FallbackValue='https://youtube.com/...'}" 
                                   Foreground="#A6ADC8" FontSize="11" Margin="0,3,0,0" 
                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>

                                    <!-- Silmə düyməsi — yalnız hover-da görünür -->
                                    <Button Name="btnDelete"
                            Grid.Column="2" Content="✕" 
                            Width="24" Height="24" Margin="8,0,0,0"
                            Background="Transparent" Foreground="#F38BA8" 
                            BorderThickness="0" Cursor="Hand" FontSize="12"
                            Tag="{Binding Id}"
                            Click="btnDeleteHistory_Click"
                            Opacity="0"/>
                                </Grid>

                                <Border.Triggers>
                                    <!-- Mouse gəldi -->
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="itemBorder"
                                                Storyboard.TargetProperty="Background.Color"
                                                To="#2A2A3E" Duration="0:0:0.15"/>
                                                <ColorAnimation Storyboard.TargetName="itemBorder"
                                                Storyboard.TargetProperty="BorderBrush.Color"
                                                To="#89B4FA" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="accentLine"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.15"/>
                                                <DoubleAnimation Storyboard.TargetName="btnDelete"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>

                                    <!-- Mouse getdi -->
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <ColorAnimation Storyboard.TargetName="itemBorder"
                                                Storyboard.TargetProperty="Background.Color"
                                                To="#1E1E2E" Duration="0:0:0.2"/>
                                                <ColorAnimation Storyboard.TargetName="itemBorder"
                                                Storyboard.TargetProperty="BorderBrush.Color"
                                                To="#313244" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="accentLine"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.2"/>
                                                <DoubleAnimation Storyboard.TargetName="btnDelete"
                                                 Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.15"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="Smart YouTube Summarizer" FontSize="24" FontWeight="Bold" Foreground="#F5E0DC"/>
                <TextBlock Text="Youtube url-i daxil edin" FontSize="12" Foreground="#A6ADC8" Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Border Name="webViewBorder"
            Background="#11111B" CornerRadius="8" Width="400" Height="220" 
            BorderBrush="#45475A" BorderThickness="1" Visibility="Collapsed">
                    <Grid>
                        <TextBlock Text="Video Önizləməsi" Foreground="#6C7086" 
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                        <wv2:WebView2 Name="webViewVideo" Visibility="Visible"/>
                    </Grid>
                </Border>

                <Button Name="btnOpenYouTube" Click="btnOpenYouTube_Click"
            HorizontalAlignment="Right" Margin="0,6,0,0"
            Padding="10,5" FontSize="11" FontWeight="SemiBold"
            Background="#CC0000" Foreground="White" BorderThickness="0" 
            Cursor="Hand" Visibility="Collapsed">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▶  YouTube-da Aç" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Grid.Row="2" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="138.246"/>
                    <ColumnDefinition Width="11.754"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Name="txtUrl" Grid.Column="0" Padding="12,10" FontSize="14" 
             Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
             VerticalContentAlignment="Center" CaretBrush="#F5E0DC"/>

                <ComboBox Name="cmbLength" Grid.Column="1" Margin="10,0,0,0" Width="140"
          Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" FontSize="13"
          VerticalContentAlignment="Center" SelectedIndex="1" IsEditable="True" Grid.ColumnSpan="2">

                    <ComboBox.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#313244" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#CDD6F4" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#313244" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#CDD6F4" />
                    </ComboBox.Resources>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Background" Value="#313244"/>
                            <Setter Property="Foreground" Value="#CDD6F4"/>
                            <Setter Property="Padding" Value="8,5"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#45475A"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#45475A"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>

                    <ComboBoxItem Content="3 Maddə"/>
                    <ComboBoxItem Content="10 Maddə"/>
                    <ComboBoxItem Content="Geniş Hesabat"/>
                </ComboBox>

                <Button Name="btnSummarize" Grid.Column="3" Content="Konspektləşdir" Click="btnSummarize_Click"
            Margin="10,0,0,0" Padding="20,10" FontSize="14" FontWeight="SemiBold"
            Background="#89B4FA" Foreground="#11111B" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <Border Grid.Row="3" Background="#313244" CornerRadius="8" Padding="15" BorderBrush="#45475A" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10">
                        <TextBox Name="txtResult" TextWrapping="Wrap" Background="Transparent" Foreground="#CDD6F4" 
                     BorderThickness="0" FontSize="14" IsReadOnly="True" AcceptsReturn="True"/>
                    </ScrollViewer>

                    <Separator Grid.Row="1" Background="#45475A" Margin="0,5,0,10"/>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Name="txtChatPrompt" Grid.Column="0" Padding="12,10" FontSize="13" 
                            Background="#1E1E2E" Foreground="#CDD6F4" BorderBrush="#45475A" BorderThickness="1"
                            VerticalContentAlignment="Center" CaretBrush="#F5E0DC"
                            Text="Bu video haqqında sual verin... (Məs: 10-cu dəqiqədə nə deyir?)" 
                            GotFocus="txtChatPrompt_GotFocus" LostFocus="txtChatPrompt_LostFocus"
                            KeyDown="txtChatPrompt_KeyDown"/>

                        <Button Name="btnSendPrompt" Grid.Column="1" Content="Göndər" Click="btnSendPrompt_Click"
                    Margin="10,0,0,0" Padding="25,10" FontSize="13" FontWeight="SemiBold"
                    Background="#C6A0F6" Foreground="#11111B" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>